# Supabase — required for all environments
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon-key>

# Session signing secret (TanStack Start SSR)
SESSION_SECRET=<random-64-char-string>

# ── Anthropic Claude (primary AI for owner board) ─────────────────────────────
# Used by:
#   - Industry Pulse (server fn)          → Claude Sonnet 4.6
#   - Bank statement drafter (server fn)  → Claude Sonnet 4.6
#   - Advisory drafter (server fn)        → Claude Sonnet 4.6
# Also set the same key as a Supabase secret for the Ask AI edge function:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_API_KEY=sk-ant-...
# Optional override (default: claude-sonnet-4-6)
# CLAUDE_MODEL=claude-sonnet-4-6

# ── Optional / legacy AI keys ─────────────────────────────────────────────────
# PDF extract still accepts these as fallbacks in some paths:
# LOVABLE_API_KEY=<lovable-gateway-key>
# GEMINI_API_KEY=AIza...
# OPENAI_API_KEY=sk-...
# GEMINI_MODEL=gemini-3.6-flash

# ── Ask AI edge function (Supabase secrets, NOT .env) ─────────────────────────
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase secrets set CLAUDE_MODEL=claude-sonnet-4-6   # optional
#   supabase secrets set ALLOWED_ORIGINS=https://your-app.vercel.app
#
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
# automatically by the Supabase runtime.

# ── QuickBooks Online (optional) ──────────────────────────────────────────────
# QBO_CLIENT_ID=
# QBO_CLIENT_SECRET=
# QBO_REDIRECT_URI=https://your-app.vercel.app/api/qbo/callback
# QBO_ENVIRONMENT=sandbox

# ── Email (Resend — usually Supabase secrets for edge fns) ────────────────────
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Milōn <noreply@yourdomain.com>
# SITE_URL=https://your-app.vercel.app
# VITE_APP_URL=https://your-app.vercel.app
