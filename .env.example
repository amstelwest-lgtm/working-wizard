# Supabase — required for all environments
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon-key>

# Session signing secret (TanStack Start SSR)
SESSION_SECRET=<random-64-char-string>

# ── Server-side AI (TanStack Start server functions) ───────────────────────────
# Industry Pulse tries these in order; at least one unlocks live AI refresh.
# Without any key, Industry Pulse still shows a curated SA sector baseline.
# LOVABLE_API_KEY=<lovable-gateway-key>
# GEMINI_API_KEY=AIza...
# OPENAI_API_KEY=sk-...
# GEMINI_MODEL=gemini-3.6-flash

# ── Ask AI edge function ──────────────────────────────────────────────────────
# Set via Supabase secrets (NOT a .env file):
#   supabase secrets set GEMINI_API_KEY=AIza...
#
# The edge function reads GEMINI_API_KEY at runtime using Deno.env.get().
# The SUPABASE_URL / SUPABASE_ANON_KEY secrets are injected automatically
# by the Supabase runtime and do not need to be set manually.
#
# ALLOWED_ORIGINS (optional) — restrict CORS origin reflection to your deployed app.
# If set, the edge function reflects only listed origins in Access-Control-Allow-Origin.
# Unset (default): allows all origins — suitable for development only.
#   supabase secrets set ALLOWED_ORIGINS=https://your-app.replit.app
#
# NOTE: GEMINI_API_KEY is a Google AI Studio / Gemini API key (starts with "AIza").
# Do NOT use the Lovable gateway key as GEMINI_API_KEY.
