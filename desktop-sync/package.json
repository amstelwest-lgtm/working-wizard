{
  "name": "@milon/desktop-sync-agent",
  "private": true,
  "version": "0.1.0",
  "description": "Milōn desktop folder-sync agent (upload-only). Not part of the web app build.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --import tsx src/cli.ts",
    "start": "node dist/cli.js",
    "package:unsigned": "node scripts/build-unsigned.mjs"
  },
  "dependencies": {
    "chokidar": "^4.0.3"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}